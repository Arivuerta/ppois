{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "laba1/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ],
          "cwd": "."
        }
      ],
      "dest": "api",
      "properties": {
        "GenerateDocumentationFile": "true",
        "NoWarn": "CS1591"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
  "_site/**"
]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "Laba1",
      "_appTitle": "Документация Laba1",
      "_enableSearch": true,
      "pdf": false
    }
  }
}